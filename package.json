{
  "name": "a11y-audit-engine",
  "version": "1.0.0",
  "description": "Automated accessibility auditing engine — axe-core + Playwright for WCAG 2.2 compliance scanning",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "a11y-audit": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "author": "Quvantic <info@quvantic.com> (https://quvantic.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mustafaautomation/a11y-audit-engine.git"
  },
  "homepage": "https://github.com/mustafaautomation/a11y-audit-engine#readme",
  "dependencies": {
    "axe-core": "^4.10.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "playwright": "^1.50.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ]
}
