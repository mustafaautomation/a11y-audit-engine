{
  "name": "a11y-audit-engine",
  "version": "1.0.0",
  "description": "Automated accessibility auditing engine — axe-core + Playwright for WCAG 2.2 compliance scanning",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "a11y-audit": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "author": "Quvantic <info@quvantic.com> (https://quvantic.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mustafaautomation/a11y-audit-engine.git"
  },
  "homepage": "https://github.com/mustafaautomation/a11y-audit-engine#readme",
  "dependencies": {
    "axe-core": "^4.11.3",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "playwright": "^1.50.0",
    "prettier": "^3.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": ["dist"]
}
